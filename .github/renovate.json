{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/Copenhagen",
  "extends": [
    ":automergeBranch",
    ":automergePatch",
    ":automergeStableNonMajor",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":ignoreModulesAndTests",
    ":ignoreUnstable",
    ":prImmediately",
    ":renovatePrefix",
    ":semanticCommits",
    ":semanticPrefixChore",
    ":separateMajorReleases",
    ":skipStatusChecks",
    ":updateNotScheduled",
    "group:monorepos",
    "group:recommended",
    "helpers:disableTypesNodeMajor",
    "workarounds:all"
  ],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "oxfmt: minimal config, treat 0.x minors as safe and automerge them",
      "matchPackageNames": ["oxfmt"],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    }
  ]
}
