{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc"],
  "ignorePatterns": [".vscode/", ".yarn/", "node_modules/", "dist/"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": ["error", { "caughtErrorsIgnorePattern": "^ignore" }]
  },
  "env": {
    "builtin": true
  },
  "options": {}
}
